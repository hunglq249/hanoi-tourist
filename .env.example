# ============================================
# HANOI TOURISM - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values

# ============================================
# ZALO OA INTEGRATION
# ============================================
# Đăng ký tại: https://oa.zalo.me
# Hướng dẫn: https://developers.zalo.me/docs/official-account

# Access Token từ Zalo OA Dashboard
ZALO_ACCESS_TOKEN=your_zalo_oa_access_token_here

# User ID Zalo của admin (người nhận thông báo)
# Lấy bằng cách: Người dùng nhắn tin cho OA của bạn → lấy user_id từ webhook
ZALO_ADMIN_USER_ID=your_zalo_user_id_here

# ============================================
# DATABASE (Production)
# ============================================
# Khuyến nghị dùng Supabase (free tier): https://supabase.com
# hoặc Vercel KV: https://vercel.com/docs/storage/vercel-kv
DATABASE_URL=your_database_url_here

# ============================================
# SITE URL
# ============================================
NEXT_PUBLIC_SITE_URL=https://hanoitourism.vn
